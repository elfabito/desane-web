---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../PageHeader.astro';
import DesignWorkGrid from '../design/DesignWorkGrid.astro';
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title={t('meta.projects.title')}
  description={t('meta.projects.description')}
  card="proyectos"
>
  <PageHeader slot="header" lang={lang} />
  <div class="container-page py-12 md:py-16">
    <div class="mb-10 max-w-2xl md:mb-12">
      <h1 class="text-4xl font-extrabold tracking-tight md:text-5xl">{t('projects.title')}</h1>
      <span class="mt-4 block h-1 w-14 rounded-full bg-accent" aria-hidden="true"></span>
      <p class="mt-5 text-lg text-pretty text-muted">{t('projects.intro')}</p>
    </div>
    <DesignWorkGrid lang={lang} />
  </div>
</BaseLayout>
