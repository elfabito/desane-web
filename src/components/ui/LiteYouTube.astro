---
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  id: string;
  /** Names the video for the play button and the player */
  title: string;
  lang: Lang;
  /** For a video near the top of the page */
  eager?: boolean;
}

// YouTube's thumbnail with a play button; the player (no-cookie domain) only loads after a click.
// Without JS the link opens the video on YouTube.
const { id, title, lang, eager = false } = Astro.props;
const t = useTranslations(lang);
---

<div class="relative aspect-video overflow-hidden rounded-xl bg-black ring-1 ring-border">
  <a
    href={`https://www.youtube.com/watch?v=${id}`}
    data-video-id={id}
    data-title={title}
    class="group absolute inset-0 grid place-items-center"
  >
    <img
      src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
      alt=""
      width="480"
      height="360"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class="absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <span
      class="relative grid size-16 place-items-center rounded-full bg-black/70 text-white shadow-lg backdrop-blur-sm transition-colors group-hover:bg-accent-strong"
      aria-hidden="true"
    >
      <Icon name="play" class="size-7 translate-x-0.5" />
    </span>
    <span class="sr-only">{t('video.play', { title })}</span>
  </a>
</div>

<script>
  let warmed = false;
  // Open the connections the player needs as soon as the visitor shows intent
  const warmUp = () => {
    if (warmed) return;
    warmed = true;
    for (const href of ['https://www.youtube-nocookie.com', 'https://www.youtube.com']) {
      const link = Object.assign(document.createElement('link'), { rel: 'preconnect', href });
      document.head.append(link);
    }
  };

  const play = (link: HTMLAnchorElement) => {
    const iframe = document.createElement('iframe');
    // hl puts the player controls in the page language
    iframe.src = `https://www.youtube-nocookie.com/embed/${link.dataset.videoId}?autoplay=1&rel=0&playsinline=1&hl=${document.documentElement.lang}`;
    iframe.title = link.dataset.title ?? '';
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    iframe.allowFullscreen = true;
    iframe.className = 'absolute inset-0 size-full';
    link.replaceWith(iframe);
    iframe.focus();
  };

  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-video-id]')) {
    // With JS the link plays the video in place, so it behaves as a button
    link.setAttribute('role', 'button');
    link.addEventListener('pointerover', warmUp, { once: true });
    link.addEventListener('focus', warmUp, { once: true });
    link.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      play(link);
    });
    link.addEventListener('keydown', (event) => {
      if (event.key !== ' ') return;
      event.preventDefault();
      play(link);
    });
  }
</script>
