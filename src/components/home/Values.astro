---
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { getProfile } from '../../lib/content';
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { values } = await getProfile();
---

<section aria-labelledby="values-title" class="bg-surface">
  <div class="container-page py-16 md:py-24">
    <SectionHeading id="values-title" title={t('values.title')} />
    <ul class="grid gap-6 md:grid-cols-3">
      {
        values.map(({ icon, title, text }) => (
          <li class="rounded-2xl bg-bg p-7 ring-1 ring-border" data-reveal>
            <span class="grid size-12 place-items-center rounded-full bg-sea-soft text-accent-strong">
              <Icon name={icon} class="size-6" />
            </span>
            <h3 class="mt-5 text-xl font-bold">{title[lang]}</h3>
            <p class="mt-3 leading-relaxed text-muted">{text[lang]}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
