{
  "name": "desane-web",
  "compatibility_date": "2026-10-26",
  // Static site only: no Worker script, Cloudflare serves the Astro build as is
  "assets": {
    "directory": "./dist",
    // A missing URL gets the closest 404.html, so /en/* gets the English one
    "not_found_handling": "404-page"
  }
}
